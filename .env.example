# Copy to .env.local and fill in. Next.js loads it automatically.

# --- Model provider ----------------------------------------------------------
# Pick one in Settings → Model provider (stored in the database), or set a default:
#   claude_subscription  Claude Pro/Max via your Claude Code login or a `claude setup-token` token
#   anthropic_api        Anthropic API key
#   openai_subscription  ChatGPT Plus/Pro via Codex "Sign in with ChatGPT"
#   openai_api           OpenAI API key (via Codex)
# POPPET_PROVIDER=claude_subscription
# Anthropic API key (can also be pasted in Settings).
ANTHROPIC_API_KEY=
# Default Claude model; the chat composer can switch to claude-opus-5-5 for hard tasks.
POPPET_MODEL=claude-sonnet-5-5
# OpenAI API key (can also be pasted in Settings) and an optional Codex model override.
OPENAI_API_KEY=
# POPPET_OPENAI_MODEL=

# --- Google (Gmail + Docs) -------------------------------------------------
# OAuth client of type "Web application" with this authorized redirect URI:
#   http://localhost:3000/api/oauth/google/callback
# Enable the Gmail API and the Google Drive API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reddit (read-only "script" app: https://www.reddit.com/prefs/apps) -----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=poppet/0.1 (by u/your_username)

# --- Local runtime ----------------------------------------------------------
# Where Poppet keeps its database, registry, exports and Chrome profile.
# POPPET_HOME=./workspace
# POPPET_APP_URL=http://localhost:3000
# Browser: headed by default; set to 1 to hide the window.
# POPPET_BROWSER_HEADLESS=0
# POPPET_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Secrets: keychain (default on macOS) | file | memory
# POPPET_SECRETS=keychain
# Sandbox for agent-written tools: docker | disabled
# POPPET_SANDBOX=docker
# Approvals expire after this many ms (default 30 minutes).
# POPPET_APPROVAL_TIMEOUT_MS=1800000
